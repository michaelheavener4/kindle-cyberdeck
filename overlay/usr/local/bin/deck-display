#!/usr/bin/python3
"""Show the Omarchy desktop on this Kindle, slowly enough for the panel.

The laptop keeps a headless screen at 1272x1696. This page pulls a grayscale
picture about every 4 seconds over the existing SSH-to-Omarchy path. A picture
that matches the last one is not drawn, so a still page does not keep flashing
the panel. There is no e-ink waveform control from X.

Touch does not click the laptop. Now forces one refresh, pause holds the
current picture, and close removes the laptop's extra screen.
"""

import gzip
import hashlib
import os
import subprocess
import sys
import threading

INTERVAL_MS = 4000
FLAG = "/tmp/kindle-display.on"
REMOTE = 'bash -lc \'exec "$HOME/.local/bin/kindle-display" %s\''


def remote_command(action):
    if action not in ("start", "stop", "grab"):
        raise ValueError(action)
    return REMOTE % action


def parse_p6(blob):
    if len(blob) < 10 or blob[:2] != b"P6":
        raise ValueError("The picture is not a PPM.")
    i = 2
    tokens = []
    n = len(blob)
    while len(tokens) < 3:
        if i >= n:
            raise ValueError("The picture header is short.")
        c = blob[i]
        if c in (9, 10, 13, 32):
            i += 1
            continue
        if c == 35:
            while i < n and blob[i] != 10:
                i += 1
            continue
        start = i
        while i < n and blob[i] not in (9, 10, 13, 32):
            i += 1
        tokens.append(blob[start:i])
    if i >= n or blob[i] not in (9, 10, 13, 32):
        raise ValueError("The picture header is not finished.")
    i += 1
    try:
        width = int(tokens[0])
        height = int(tokens[1])
        maxval = int(tokens[2])
    except ValueError as exc:
        raise ValueError("The picture header is not numbers.") from exc
    if width < 1 or height < 1 or width > 4000 or height > 4000:
        raise ValueError("The picture size is unexpected.")
    if maxval != 255:
        raise ValueError("The picture maxval is not 255.")
    need = width * height * 3
    pixels = bytes(blob[i : i + need])
    if len(pixels) != need:
        raise ValueError("The picture is short.")
    return width, height, pixels


def decide(old_hash, new_hash, force):
    if force or old_hash != new_hash:
        return "draw"
    return "hold"


def log(text):
    line = text.replace("\n", " ")[:500] + "\n"
    for path in ("/mnt/kindle/linux/display.log", "/tmp/kindle-display.log"):
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "a", encoding="utf-8") as fh:
                fh.write(line)
            return
        except OSError:
            continue


def mark_flag():
    try:
        with open(FLAG, "w", encoding="utf-8") as fh:
            fh.write("on\n")
    except OSError as exc:
        log("flag: %s" % exc)


def clear_flag():
    try:
        os.remove(FLAG)
    except OSError:
        pass


def ssh(action, timeout):
    cmd = [
        "ssh",
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "ConnectTimeout=15",
        "omarchy",
        remote_command(action),
    ]
    return subprocess.run(cmd, capture_output=True, timeout=timeout)


def net_ready():
    proc = subprocess.run(
        ["sh", "-c", ". /usr/local/bin/deck-net\ndeck_net_ready\n"],
        capture_output=True,
        text=True,
        timeout=45,
    )
    text = ((proc.stdout or "") + (proc.stderr or "")).strip()
    return proc.returncode == 0, text


def status_line(text):
    lines = [part.strip() for part in text.splitlines() if part.strip()]
    picked = [part for part in lines if "tailnet" in part or part.startswith("Choose 7")]
    if picked:
        return " ".join(picked)
    if not lines:
        return "The laptop could not be reached."
    return lines[-1][:180]


def stop_remote():
    try:
        proc = ssh("stop", 25)
    except (OSError, subprocess.TimeoutExpired) as exc:
        log("stop: %s" % exc)
        return False
    if proc.returncode == 0:
        clear_flag()
        log("stop: " + proc.stdout.decode("utf-8", "replace")[:200])
        return True
    err = (proc.stderr or proc.stdout).decode("utf-8", "replace")
    log("stop failed: " + err[:300])
    return False


def keyboard(action):
    try:
        subprocess.Popen(
            ["kindle-keyboard", action],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def self_test():
    raw = b"P6\n# note\n1 1\n255\n" + bytes([8, 8, 8])
    width, height, pixels = parse_p6(raw)
    assert (width, height, pixels) == (1, 1, bytes([8, 8, 8]))
    packed = gzip.compress(raw)
    assert parse_p6(gzip.decompress(packed))[2] == pixels
    digest = hashlib.sha256(pixels).hexdigest()
    assert decide(None, digest, False) == "draw"
    assert decide(digest, digest, False) == "hold"
    assert decide(digest, digest, True) == "draw"
    assert decide(digest, "other", False) == "draw"
    for action in ("start", "stop", "grab"):
        cmd = remote_command(action)
        assert cmd == ('bash -lc \'exec "$HOME/.local/bin/kindle-display" %s\'' % action)
        assert "-tt" not in cmd
    try:
        remote_command("reboot")
    except ValueError:
        pass
    else:
        raise SystemExit("an unknown action was accepted")
    try:
        parse_p6(b"P6\n1 1\n255\n\x00")
    except ValueError:
        pass
    else:
        raise SystemExit("a short picture was accepted")
    note = status_line(
        "waiting\nThis Kindle is not on the tailnet yet.\nChoose 7 and open the URL it prints.\n"
    )
    assert "tailnet" in note and "Choose 7" in note
    print("deck-display self-test ok")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--self-test":
        self_test()
        return 0

    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk

    class Screen(Gtk.Window):
        def __init__(self):
            super().__init__(title="omarchy")
            self.closing = False
            self.close_started = False
            self.booting = True
            self.started = False
            self.output_on = False
            self.paused = False
            self.busy = False
            self.timer = 0
            self.digest = None
            self.pixbuf = None
            self.pixels = b""
            self.status_text = ""
            self.net_lock = threading.Lock()
            self.pause_button = None
            self.boot_thread = None

            self.set_decorated(False)
            self.connect("delete-event", self._delete)
            self.connect("destroy", self._destroy)

            css = Gtk.CssProvider()
            css.load_from_data(
                b"""
                window, drawingarea, box, label {
                    background: #ffffff;
                    color: #141414;
                }
                #bar { background: #ffffff; }
                #hint, #status {
                    font-family: "Liberation Sans", "DejaVu Sans", sans-serif;
                    font-size: 26px;
                    color: #000000;
                }
                button {
                    font-family: "Liberation Sans", "DejaVu Sans", sans-serif;
                    font-size: 30px;
                    background: #ffffff;
                    color: #000000;
                    border: 3px solid #000000;
                    border-radius: 0;
                    padding: 10px 8px;
                    min-height: 76px;
                }
                button:active { background: #000000; color: #ffffff; }
                """
            )
            Gtk.StyleContext.add_provider_for_screen(
                self.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

            overlay = Gtk.Overlay()
            self.canvas = Gtk.DrawingArea()
            self.canvas.connect("draw", self._draw)
            overlay.add(self.canvas)

            bar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            bar.set_name("bar")
            bar.set_halign(Gtk.Align.FILL)
            bar.set_valign(Gtk.Align.END)
            bar.set_margin_start(12)
            bar.set_margin_end(12)
            bar.set_margin_bottom(8)
            hint = Gtk.Label(label="On the laptop: Super Shift Alt Right.")
            hint.set_name("hint")
            hint.set_xalign(0)
            bar.pack_start(hint, False, False, 0)
            self.status = Gtk.Label(label="")
            self.status.set_name("status")
            self.status.set_xalign(0)
            self.status.set_line_wrap(True)
            self.status.set_size_request(-1, 64)
            bar.pack_start(self.status, False, False, 0)

            buttons = Gtk.Box(spacing=10)
            buttons.set_homogeneous(True)
            for label, handler in (
                ("now", self._now),
                ("pause", self._toggle_pause),
                ("close", self._close),
            ):
                button = Gtk.Button(label=label)
                button.set_can_focus(False)
                button.connect("clicked", handler)
                buttons.pack_start(button, True, True, 0)
                if label == "pause":
                    self.pause_button = button
            bar.pack_start(buttons, False, False, 0)
            overlay.add_overlay(bar)
            self.add(overlay)

            self._set_status("Reaching Omarchy.")
            self._fit()
            keyboard("hide")
            self.show_all()
            GLib.timeout_add(2000, self._pulse)
            self.boot_thread = threading.Thread(target=self._boot, daemon=True)
            self.boot_thread.start()

        def _fit(self):
            width, height = 1272, 1696
            display = Gdk.Display.get_default()
            if display is not None:
                mon = display.get_primary_monitor()
                if mon is None and display.get_n_monitors() > 0:
                    mon = display.get_monitor(0)
                if mon is not None:
                    geom = mon.get_geometry()
                    if geom.width > 100 and geom.height > 100:
                        width, height = geom.width, geom.height
            # Leave the JWM tray its 112px. The picture stays 1:1 and is clipped.
            self.resize(width, max(400, height - 112))
            self.move(0, 0)

        def _set_status(self, text):
            if text == self.status_text:
                return
            self.status_text = text
            self.status.set_text(text)

        def _draw(self, _widget, cr):
            if self.pixbuf is not None:
                Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
                cr.paint()
            else:
                cr.set_source_rgb(1, 1, 1)
                cr.paint()
            return False

        def _pulse(self):
            if not self.booting:
                return False
            # A still status looks frozen on this panel. Count so the wait is visible.
            shown = self.status_text
            if shown.startswith("Reaching Omarchy"):
                dot = shown.count(".") 
                self._set_status("Reaching Omarchy" + ("." * ((dot % 3) + 1)))
            return True

        def _boot(self):
            try:
                ok, text = net_ready()
            except (OSError, subprocess.TimeoutExpired) as exc:
                ok, text = False, str(exc)
            if self.closing:
                return
            if not ok:
                log("ready: " + text)
                GLib.idle_add(self._boot_fail, status_line(text))
                return
            with self.net_lock:
                if self.closing:
                    return
                try:
                    proc = ssh("start", 40)
                except (OSError, subprocess.TimeoutExpired) as exc:
                    GLib.idle_add(self._boot_fail, "The laptop took too long.")
                    log("start: %s" % exc)
                    return
                if proc.returncode != 0:
                    err = (proc.stderr or proc.stdout).decode("utf-8", "replace")
                    log("start failed: " + err[:300])
                    GLib.idle_add(self._boot_fail, status_line(err))
                    return
                self.output_on = True
                mark_flag()
                log("start: " + proc.stdout.decode("utf-8", "replace")[:200])
                if self.closing:
                    stop_remote()
                    self.output_on = False
                    return
            GLib.idle_add(self._started)

        def _boot_fail(self, text):
            self.booting = False
            self._set_status(text)
            return False

        def _started(self):
            self.booting = False
            self.started = True
            self._set_status("Waiting for the first picture.")
            self._arm()
            self._pull(False)
            return False

        def _arm(self):
            if self.timer:
                GLib.source_remove(self.timer)
            self.timer = GLib.timeout_add(INTERVAL_MS, self._tick)

        def _tick(self):
            if self.closing or self.paused:
                self.timer = 0
                return False
            self._pull(False)
            return True

        def _pull(self, force):
            if self.closing or self.busy or not self.started:
                return
            self.busy = True

            def work():
                try:
                    proc = ssh("grab", 45)
                except (OSError, subprocess.TimeoutExpired) as exc:
                    GLib.idle_add(self._grab_fail, "The laptop took too long.")
                    log("grab: %s" % exc)
                    return
                if self.closing:
                    GLib.idle_add(self._grab_fail, "")
                    return
                if proc.returncode != 0 or not proc.stdout:
                    err = (proc.stderr or proc.stdout).decode("utf-8", "replace")
                    log("grab failed: " + err[:300])
                    GLib.idle_add(self._grab_fail, status_line(err))
                    return
                try:
                    blob = gzip.decompress(proc.stdout)
                except OSError:
                    GLib.idle_add(self._grab_fail, "The frame was not a picture.")
                    return
                GLib.idle_add(self._apply, blob, force)

            threading.Thread(target=work, daemon=True).start()

        def _grab_fail(self, text):
            self.busy = False
            if text and not self.closing:
                self._set_status(text)
            return False

        def _apply(self, blob, force):
            self.busy = False
            if self.closing:
                return False
            try:
                width, height, pixels = parse_p6(blob)
            except ValueError as exc:
                self._set_status("The frame was not a picture.")
                log(str(exc))
                return False
            digest = hashlib.sha256(pixels).hexdigest()
            action = decide(self.digest, digest, force)
            if action == "hold":
                self._set_status("Held. The page did not change.")
                return False
            self.digest = digest
            self.pixels = pixels
            self.pixbuf = GdkPixbuf.Pixbuf.new_from_data(
                pixels,
                GdkPixbuf.Colorspace.RGB,
                False,
                8,
                width,
                height,
                width * 3,
            )
            self.canvas.queue_draw()
            self._set_status("Drawn.")
            return False

        def _now(self, *_args):
            if self.closing or not self.started:
                return
            self._pull(True)

        def _toggle_pause(self, button):
            if self.closing or not self.started:
                return
            self.paused = not self.paused
            if self.paused:
                if self.timer:
                    GLib.source_remove(self.timer)
                    self.timer = 0
                button.set_label("resume")
                self._set_status("Paused.")
            else:
                button.set_label("pause")
                self._arm()
                self._pull(False)

        def _delete(self, *_args):
            self._close()
            return True

        def _close(self, *_args):
            if self.close_started:
                return
            self.close_started = True
            self.closing = True
            self.booting = False
            if self.timer:
                GLib.source_remove(self.timer)
                self.timer = 0
            self._set_status("Putting the laptop screen back.")
            while Gtk.events_pending():
                Gtk.main_iteration_do(False)
            # Wait until a start that is already in flight has finished,
            # so closing cannot leave the laptop output behind.
            if self.boot_thread is not None:
                self.boot_thread.join(timeout=50)
            with self.net_lock:
                if self.output_on:
                    stop_remote()
                    self.output_on = False
            keyboard("show")
            self.destroy()

        def _destroy(self, *_args):
            Gtk.main_quit()

    win = Screen()
    win._fit()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
