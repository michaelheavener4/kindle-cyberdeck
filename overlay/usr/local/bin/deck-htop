#!/bin/sh
# A slower monochrome display reduces e-ink refreshes; 22pt fits useful columns.
. /usr/local/bin/kindle-session-env
case "${1:-kindle}" in
  kindle) exec xterm -fa 'DejaVu Sans Mono' -fs 22 -maximized -T 'Kindle htop' -e htop -C -d 50 ;;
  omarchy|mac)
    exec xterm -fa 'DejaVu Sans Mono' -fs 22 -maximized -T "$1 htop" -e ssh -tt "$1" 'export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; exec htop -C -d 50' ;;
  *) echo 'Usage: deck-htop [kindle|omarchy|mac]' >&2; exit 2 ;;
esac
