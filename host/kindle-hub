    return layout('Lichess · Connect account',body)


class Handler(BaseHTTPRequestHandler):
    def log_message(self,*_): pass

    def send(self,body,kind='text/html; charset=utf-8',status=200):
        data=body.encode() if isinstance(body,str) else body
        self.send_response(status);self.send_header('Content-Type',kind)
        self.send_header('Content-Length',str(len(data)))
        self.send_header('X-Content-Type-Options','nosniff')
        if self.path.startswith('/lichess'):
            self.send_header('Cache-Control','no-store')
            self.send_header('Referrer-Policy','no-referrer')
        self.end_headers();self.wfile.write(data)

    def redirect(self,path):
        self.send_response(303);self.send_header('Location',path);self.end_headers()

    def do_GET(self):
        url=U.urlsplit(self.path);path=U.unquote(url.path);query=U.parse_qs(url.query)
        get=lambda key,default='':query.get(key,[default])[0]
        try:
            if path=='/lichess':return self.send(lichess_page())
            if path=='/lichess/callback':
                try:
                    name=LICHESS_LOGIN.complete(get('state'),get('code'),get('error'))
                    try:
                        LICHESS_LOGIN.deliver();message=f'Signed in as {name}. Login delivered to the Kindle.'
                    except ValueError as exc:message=str(exc)
                    return self.send(lichess_page(message))
                except ValueError as exc:return self.send(lichess_page(str(exc)),status=400)
                except Exception:return self.send(lichess_page('Lichess sign-in could not finish. Please start again.'),status=502)
            if path=='/health': return self.send('{"app":"kindle-hub","ok":true,"build":"touch-v3"}','application/json')
            if path=='/home': return self.send(layout('Cyberdeck', '<a class="tile" href="/chat">Chat</a><a class="tile" href="/archive">Archive · Books & Magazines</a><p>Use the large browser toolbar for Back, Home, Keyboard and scrolling tools.</p>'))
            if path in {'/','/chat'}: return self.send(chat_home())
            if path=='/chats': return self.send(layout('Chat history','<div class="history">'+chat_links()+'</div>'))
            if path.startswith('/chat/'): return self.send(chat_page(path.rsplit('/',1)[1]))
            if path=='/archive': return self.send(archive_search(get('q'),get('kind','all'),max(1,min(100,int(get('page','1')))),**{key:get(key) for key in ARCHIVE_FIELDS}))
            if path.startswith('/archive/job/'):return self.send(archive_job(path.rsplit('/',1)[-1]))
            for prefix,kind in [('/archive/item/','item'),('/archive/read/','read'),('/archive/pages/','pages'),('/archive/scan/','scan'),('/archive/image/','image')]:
                if not path.startswith(prefix): continue
                ident=item_id(path[len(prefix):]);page=max(1,min(10000,int(get('page','1'))))
                if kind=='item': return self.send(archive_item(ident,get('format')))
                if kind=='read': return self.send(archive_text(ident,page))
                if kind=='scan': return self.send(pdf_image(ident,page,get('file'),**display_options(get,'crisp')),'image/png')
                if kind=='image': return self.send(fetch('https://archive.org/services/img/'+U.quote(ident),5_000_000),'image/jpeg')
                if kind=='pages': return self.send(archive_reader(ident,page,get))
            self.send(layout('Not found','<p>That page does not exist.</p>'),status=404)
        except Exception as exc:
            back='/archive'
            self.send(layout('Could not open that page',f'<p>{esc(exc)}</p><p><a class="button" href="{back}">Back to browsing</a></p>'),status=502)

    def do_POST(self):
        try:
            length=int(self.headers.get('Content-Length','0'))
            if not 0<length<=32768: raise ValueError('Message is too large.')
            form=U.parse_qs(self.rfile.read(length).decode())
            get=lambda key,default='':form.get(key,[default])[0]
            if not secrets.compare_digest(get('csrf'),TOKEN): return self.send('Invalid form token.',status=403)
            if self.path=='/lichess/connect':return self.redirect(LICHESS_LOGIN.begin())
            if self.path=='/lichess/deliver':
                try:
                    name=LICHESS_LOGIN.deliver();message=f'Login for {name} delivered. Open Games → Lichess on the Kindle.'
                except ValueError as exc:message=str(exc)
                return self.send(lichess_page(message))
            if self.path=='/archive/send':
                ident=item_id(get('item'));data=metadata(ident)
                file=next((f for f in delivery.supported_files(data) if f['name']==get('file')),None)
                if not file:raise ValueError('Choose an available public document.')
                title=str(data.get('metadata',{}).get('title',ident));job_id=secrets.token_hex(10)
                with db() as con:con.execute('INSERT INTO archive_jobs VALUES(?,?,?,?,?,?,?)',(job_id,ident,file['name'],title,'queued','Starting transfer…',''))
                POOL.submit(archive_transfer,job_id,get('action')=='open')
                return self.redirect('/archive/job/'+job_id)
            if self.path=='/archive/open':
                job_id=get('job')
                with db() as con:job=con.execute('SELECT * FROM archive_jobs WHERE id=?',(job_id,)).fetchone()
                if not job or not job['destination']:raise ValueError('Send the document first.')
                def open_existing():
                    try:
                        delivery.open_reader(job['destination']);message='Opening in the Kindle reader.';state='sent'
                    except Exception as exc:message=str(exc);state='error'
                    with db() as con:con.execute('UPDATE archive_jobs SET state=?,message=? WHERE id=?',(state,message,job_id))
                with db() as con:con.execute("UPDATE archive_jobs SET state='working',message='Opening native reader…' WHERE id=?",(job_id,))
                POOL.submit(open_existing)
                return self.redirect('/archive/job/'+job_id)
            if self.path=='/new':
                provider=get('provider','fm')
                if provider not in {'fm','ollama'}: raise ValueError('Invalid provider.')
                ident=secrets.token_hex(10)
                with db() as con: con.execute('INSERT INTO chats VALUES(?,?,?,?)',(ident,'New conversation',provider,time.time()))
                return self.redirect('/chat/'+ident+'#compose')
            if self.path=='/send':
                ident=get('chat_id');message=get('message').strip()[:4000]
                if not message: raise ValueError('Enter a message.')
                with LOCK,db() as con:
                    chat=con.execute('SELECT * FROM chats WHERE id=?',(ident,)).fetchone()
                    if not chat: raise ValueError('Conversation not found.')
                    if con.execute("SELECT 1 FROM messages WHERE chat_id=? AND status='pending'",(ident,)).fetchone():
                        return self.redirect('/chat/'+ident)
                    con.execute('INSERT INTO messages(chat_id,role,content,status) VALUES(?,?,?,?)',(ident,'user',message,'done'))
                    if chat['title']=='New conversation': con.execute('UPDATE chats SET title=? WHERE id=?',(message[:55],ident))
                    cur=con.execute('INSERT INTO messages(chat_id,role,content,status) VALUES(?,?,?,?)',(ident,'assistant','','pending'))
                    message_id=cur.lastrowid
                POOL.submit(answer,ident,message_id)
                return self.redirect('/chat/'+ident)
            self.send('Not found',status=404)
        except Exception as exc: self.send(layout('Could not submit',f'<p>{esc(exc)}</p>'),status=400)


def healthy():
    try:
        with R.urlopen(BASE+'/health',timeout=1) as response: return json.load(response).get('app')=='kindle-hub'
    except OSError: return False


def ensure():
    if healthy(): return
    STATE.mkdir(parents=True,exist_ok=True)
    with open(STATE/'server.log','ab',buffering=0) as log:
        subprocess.Popen([sys.executable,__file__,'serve'],stdin=subprocess.DEVNULL,stdout=log,stderr=log,start_new_session=True)
    for _ in range(30):
        if healthy(): return
        time.sleep(0.2)
    raise RuntimeError('The private Kindle hub did not start.')


def main():
    parser=argparse.ArgumentParser();parser.add_argument('action',choices=['serve','ensure','url']);parser.add_argument('page',nargs='?',default='chat');args=parser.parse_args()
    os.umask(0o077)
    if args.action=='serve':
        init();server=ThreadingHTTPServer(('127.0.0.1',PORT),Handler)
        (STATE/'server.pid').write_text(str(os.getpid()))
        server.serve_forever()
    else:
        ensure()
        if args.action=='url': print(BASE+'/'+(args.page if args.page in {'archive','lichess'} else 'chat'))


if __name__=='__main__': main()
