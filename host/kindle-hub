def chat_page(chat_id):
    with db() as con:
        chat=con.execute('SELECT * FROM chats WHERE id=?',(chat_id,)).fetchone()
        messages=con.execute('SELECT * FROM messages WHERE chat_id=? ORDER BY id',(chat_id,)).fetchall()
    if not chat: raise ValueError('Conversation not found.')
    pending=any(m['status']=='pending' for m in messages)
    body=''
    for message in messages:
        role='You' if message['role']=='user' else 'Assistant'
        text='Thinking…' if message['status']=='pending' else message['content']
        body+=f'<div class="message {esc(message["role"])}"><strong>{role}</strong><div class="content">{esc(text)}</div></div>'
    if not pending:
        body+=f'''<form id="compose" action="/send" method="post">{csrf()}<input type="hidden" name="chat_id" value="{esc(chat_id)}"><label>Your message<textarea name="message" rows="4" maxlength="4000" required></textarea></label><p><button>Send</button> <a href="/chat">New conversation</a></p></form>'''
    else: body+='<p>Waiting for the model. This page updates automatically.</p>'
    return layout(chat['title'],body,pending)


def answer(chat_id,message_id):
    try:
        with db() as con:
            chat=con.execute('SELECT * FROM chats WHERE id=?',(chat_id,)).fetchone()
            rows=con.execute("SELECT role,content FROM messages WHERE chat_id=? AND status='done' ORDER BY id DESC LIMIT 6",(chat_id,)).fetchall()
        data={'provider':chat['provider'],'messages':[dict(r) for r in reversed(rows)]}
        command='export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; exec kindle-local-ai --respond'
        result=subprocess.run(['ssh','-o','BatchMode=yes','-o','ConnectTimeout=10','mac',command],
            input=json.dumps(data),text=True,capture_output=True,timeout=260)
        response=json.loads(result.stdout)
        if response.get('error'): raise RuntimeError(response['error'])
        text=response.get('reply','').strip()
        if not text: raise RuntimeError('The model returned an empty reply.')
    except Exception as exc: text='Could not answer: '+str(exc)
    with db() as con: con.execute("UPDATE messages SET content=?,status='done' WHERE id=?",(text,message_id))


def item_id(value):
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,200}',value): raise ValueError('Invalid Archive identifier.')
    return value


def metadata(identifier):
    identifier=item_id(identifier)
    path=STATE/'cache'/('meta-'+identifier+'.json')
    if not path.exists() or time.time()-path.stat().st_mtime>3600:
        data=fetch('https://archive.org/metadata/'+U.quote(identifier),8_000_000)
        json.loads(data);path.write_bytes(data)
    return json.loads(path.read_bytes())


