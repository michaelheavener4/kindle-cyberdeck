def select(name, label, choices, selected):
    options=''.join(f'<option value="{esc(value)}"'+(' selected' if value==selected else '')+f'>{esc(text)}</option>' for value,text in choices)
    return f'<label>{esc(label)}<select name="{esc(name)}">{options}</select></label>'


def archive_url(**params):
    return '/archive?'+U.urlencode({k:v for k,v in params.items() if v not in ('',None)})


def literal(value):
    return '"'+value.replace('\\','\\\\').replace('"','\\"')+'"'


def archive_query(query,kind,options):
    clauses=[]
    scope=options.get('scope','all')
    if query:
        clauses.append(f'{scope}:{literal(query)}' if scope in {'title','creator','subject','description'} else '('+query+')')
    if kind in dict(ARCHIVE_TYPES) and kind!='all': clauses.append('mediatype:'+kind)
    for key in ('title','creator','subject','description','collection','language','format'):
        value=options.get(key,'')
        if value: clauses.append(key+':'+literal(value))
    start,end=options.get('year_from',''),options.get('year_to','')
    if start or end:
        if any(v and (not re.fullmatch(r'[0-9]{4}',v) or not 1<=int(v)<=9999) for v in (start,end)):
            raise ValueError('Use four-digit years, such as 1900 or 2020.')
        if start and end and start>end: raise ValueError('The first year must be before the last year.')
        clauses.append(f'date:[{start+"-01-01" if start else "*"} TO {end+"-12-31" if end else "*"}]')
    if options.get('access')=='public': clauses.append('NOT access-restricted-item:true')
    return ' AND '.join(clauses) or '*:*'


