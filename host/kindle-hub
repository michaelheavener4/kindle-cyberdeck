    if ARCHIVE_SORTS[order][1]: params['sort[]']=ARCHIVE_SORTS[order][1]
    result=json.loads(fetch('https://archive.org/advancedsearch.php?'+U.urlencode(params,doseq=True)))
    if not isinstance(result.get('response'),dict):
