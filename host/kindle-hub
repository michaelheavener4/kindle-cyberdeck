        body+=f'<p>Connected account: <strong>{esc(name)}</strong></p><form method="post" action="/lichess/deliver">{csrf()}<button>Send login to Kindle</button></form><p>Open Games → Lichess on the Kindle. The login screen picks up your account automatically.</p>'
    body+=f'<form method="post" action="/lichess/connect">{csrf()}<button>{"Change account" if name else "Sign in with Lichess"}</button></form>'
