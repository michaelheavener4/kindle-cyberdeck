def esc(value): return html.escape(str(value),quote=True)


def fetch(url,limit=4_000_000):
    req=R.Request(url,headers={'User-Agent':'Cyberdeck/1.0 (personal Archive reader)'})
    with R.urlopen(req,timeout=25) as response: data=response.read(limit+1)
    if len(data)>limit: raise ValueError('This file is too large for the lightweight reader. Use its original Archive.org page.')
    return data


@contextmanager
def db():
    con=sqlite3.connect(STATE/'chats.sqlite3',timeout=15)
    con.row_factory=sqlite3.Row
    try:
        with con: yield con
    finally: con.close()


