def archive_item(identifier,file_format=''):
    data=metadata(identifier);meta=data.get('metadata',{})
    title=meta.get('title',identifier)
    description=meta.get('description','')
    if isinstance(description,list): description='\n'.join(str(x) for x in description)
    description=plain(description)[:2500]
    body=f'<img class="thumb" src="/archive/image/{esc(identifier)}"><p>{esc(description)}</p><div class="clear"></div>'
    files=data.get('files',[])
    text=next((f for f in files if f.get('name','').endswith('_djvu.txt') and not f.get('private')),None)
    pdf=next((f for f in files if f.get('name','').lower().endswith('.pdf') and not f.get('private')),None)
    documents=delivery.supported_files(data)
    if file_format and any(f.get('format')==file_format for f in documents):
        documents=[f for f in documents if f.get('format')==file_format]
    if documents:
        choices=[(f['name'],Path(f['name']).suffix[1:].upper()+' · '+f['name']+f' · {int(f.get("size",0))/1_000_000:.1f} MB') for f in documents]
        body+=f'<form class="search-form" method="post" action="/archive/send">{csrf()}<input type="hidden" name="item" value="{esc(identifier)}">'
        body+=select('file','Read with Kindle',choices,documents[0]['name'])
        body+='<button name="action" value="open">Send to Kindle &amp; Read</button><button class="secondary" name="action" value="send">Send to library only</button><p class="muted">PDFs keep their magazine layout. EPUBs and supported documents are converted for Kindle. Read leaves Linux and opens the native reader.</p></form>'
    elif meta.get('mediatype')!='collection':
        body+='<p class="card">No public Kindle-compatible document under 250 MB is available for this item. Borrowing and restricted files must be accessed on Archive.org.</p>'
    body+=f'<p><a href="https://archive.org/details/{U.quote(identifier)}">Open original Archive.org item</a></p><h2>Available files</h2><ul>'
    # Collection and metadata links let readers continue browsing naturally.
    body=body.removesuffix('<h2>Available files</h2><ul>')
    if meta.get('mediatype')=='collection':
        body+=f'<p><a class="button" href="{esc(archive_url(collection=identifier,browse="1",sort="downloads"))}">Browse this collection</a></p>'
    for key,label in [('creator','Creator'),('date','Published'),('publisher','Publisher'),('language','Language'),('subject','Subjects'),('collection','Collections')]:
        values=meta.get(key,[])
        if not isinstance(values,list): values=[values]
        links=[]
        for value in values[:15]:
            if key in {'creator','language','subject','collection'}:
                links.append(f'<a href="{esc(archive_url(**{key:str(value),"browse":"1"}))}">{esc(value)}</a>')
            else: links.append(esc(value))
        if links: body+=f'<div class="facts"><strong>{label}:</strong> '+', '.join(links)+'</div>'
    public_files=[f for f in files if f.get('name') and not f.get('private')]
    formats=sorted({str(f.get('format','Other')) for f in public_files})
    if file_format not in formats and file_format!='all': file_format=''
    body+='<h2>Files · Send to Kindle</h2><p>Use the send buttons for your Kindle library or native reader. “Save original” uses the browser’s download dialog.</p>'
    format_choices=([('','Kindle documents'),('all','All files')] if documents else [('','All formats')])+[(f,f) for f in formats]
    body+=f'<form action="/archive/item/{esc(identifier)}">'+select('format','File format',format_choices,file_format)+'<button>Show files</button></form><ul>'
    sendable={f['name'] for f in delivery.supported_files(data)}
    visible=[f for f in public_files if (file_format=='all' or (not file_format and (not documents or f['name'] in sendable)) or f.get('format','Other')==file_format)]
    for file in visible[:150]:
        name=file.get('name','')
        if not name or file.get('private'): continue
        url='https://archive.org/download/'+U.quote(identifier)+'/'+U.quote(name,safe='/')
        size=int(file.get('size',0))
        size_label=f'{size/1_000_000:.1f} MB' if size>=1_000_000 else f'{size/1000:.0f} KB'
        body+=f'<li class="facts"><strong>{esc(name)}</strong><br><span class="muted">{esc(file.get("format",""))} · {size_label}</span>'
        if any(f['name']==name for f in documents):body+=archive_send_buttons(identifier,name)
        body+=f'<p><a href="{esc(url)}">Save original · browser download</a></p></li>'
    body+='</ul>'
    if len(visible)>150: body+='<p>Showing the first 150 files. Choose a format to narrow the list.</p>'
    reviews=data.get('reviews',[])
    if reviews:
        body+='<h2>Reviews</h2>'
        for review in reviews[:5]:
            body+=f'<article class="card"><strong>{esc(review.get("reviewtitle","Review"))}</strong><p>{esc(plain(review.get("reviewbody",""))[:1500])}</p></article>'
    return layout(str(title),body)


def archive_text(identifier,page=1):
    data=metadata(identifier)
    file=next((f for f in data.get('files',[]) if f.get('name','').endswith('_djvu.txt') and not f.get('private')),None)
    if not file: raise ValueError('No public text preview is available. Open the original Archive.org item.')
    path=STATE/'cache'/('text-'+identifier+'.txt')
    if not path.exists():
        path.write_bytes(fetch('https://archive.org/download/'+U.quote(identifier)+'/'+U.quote(file['name'],safe='/'),15_000_000))
    text=path.read_text(errors='replace');length=6500
    total=max(1,(len(text)+length-1)//length)
    page=max(1,min(page,total));part=text[(page-1)*length:page*length]
    nav=f'<p><a href="/archive/item/{esc(identifier)}">Item details</a> · '
    if page>1: nav+=f'<a href="?page={page-1}">Previous</a> · '
    if page*length<len(text): nav+=f'<a href="?page={page+1}">Next</a>'
    nav+='</p>'
    jump=f'<form class="jump"><label>Text page {page} of {total}<input type="number" name="page" min="1" max="{total}" value="{page}"></label><button>Go</button></form>'
    actions=archive_send_buttons(identifier,file['name']) if any(f['name']==file['name'] for f in delivery.supported_files(data)) else ''
    return layout(str(data.get('metadata',{}).get('title',identifier)),nav+actions+jump+'<div class="content">'+esc(part)+'</div>'+nav)


def reader_layout(title,body):
    page=layout(title,body)
    page=re.sub(r'<nav>.*?</nav>','',page,count=1,flags=re.S)
    page=page.replace(f'<h1>{esc(title)}</h1>','',1)
    css='body{max-width:none;margin:12px auto;padding:0 16px}.readerbar a{display:inline-block;min-height:76px;padding:16px 20px;margin:4px;border:3px solid #111;text-decoration:none;font-weight:bold;box-sizing:border-box}.reader-title{font-size:26px;margin:8px 0}.view-image{display:block;max-width:none;height:auto;margin:12px 0}.reader-options{border:3px solid #111;padding:12px}.jump{margin:4px 0}.jump label{font-size:26px}.jump input{min-height:72px}.reader-status{font-size:24px}.readerbar{background:white}'
    return page.replace('</style>',css+'</style>',1)


def display_options(get,default='photo'):
    style=get('style',default);contrast=get('contrast','normal')
    return dict(style=style if style in eink.STYLES else default,
                contrast=contrast if contrast in eink.CONTRAST else 'normal',
                invert=1 if get('invert')=='1' else 0,
                zoom=int(get('zoom','100')) if get('zoom','100') in {'100','150','200'} else 100,
                fit='page' if get('fit')=='page' else 'width',
                crop=get('crop') if get('crop') in {'left','right'} else 'full')


def display_controls(path,state,show=False):
    def url(**changes):return path+'?'+U.urlencode(dict(state,**changes))
    bar='<div class="readerbar">'
    for label,changes in [('Fit width',dict(zoom=100,fit='width')),('Fit page',dict(zoom=100,fit='page')),
                          ('Zoom −',dict(zoom=max(100,state['zoom']-50),fit='width')),('Zoom +',dict(zoom=min(200,state['zoom']+50),fit='width')),
                          ('Display options',dict(options=0 if show else 1))]:
        bar+=f'<a href="{esc(url(**changes))}">{label}</a>'
    bar+='</div>'
    if show:
        bar+=f'<form class="reader-options" action="{esc(path)}">'
        for key,value in state.items():
            if key not in {'style','contrast','invert','crop'}:bar+=f'<input type="hidden" name="{key}" value="{esc(value)}">'
        bar+=select('style','Display style',[('photo','Photo · shaded halftone'),('crisp','Crisp · text and scans'),('comic','Comic · strong black lines'),('original','Original · unprocessed tones')],state['style'])
        bar+=select('contrast','Contrast',[('soft','Soft'),('normal','Balanced'),('strong','Strong')],state['contrast'])
        bar+=select('invert','Paper / ink', [('0','Black ink on white'),('1','White ink on black')],str(state['invert']))
        if path.startswith('/archive/'):
            bar+=select('crop','Magazine spread',[('full','Whole page'),('left','Left half'),('right','Right half')],state['crop'])
        bar+='<button>Apply display settings</button></form>'
    return bar


def pdf_file(identifier,name=''):
    data=metadata(identifier)
    files=[f for f in data.get('files',[]) if f.get('name','').lower().endswith('.pdf') and not f.get('private')]
    file=next((f for f in files if f['name']==name),None) if name else next(iter(files),None)
    if not file or int(file.get('size',0))>250_000_000:raise ValueError('Choose a public PDF smaller than 250 MB.')
    return data,file


def pdf_paths(identifier,file):
    key=identifier+'-'+hashlib.sha256(file['name'].encode()).hexdigest()[:12]
    return key,STATE/'cache'/('pdf-'+key+'.pdf')


def pdf_image(identifier,page,file_name='',**options):
    _,file=pdf_file(identifier,file_name);key,pdf=pdf_paths(identifier,file)
    with PDF_LOCK:
        if not pdf.exists():
            url='https://archive.org/download/'+U.quote(identifier)+'/'+U.quote(file['name'],safe='/')
            tmp=pdf.with_suffix('.part')
            try:
                request=R.Request(url,headers={'User-Agent':'Cyberdeck reader/1.0'})
                with R.urlopen(request,timeout=45) as response,tmp.open('wb') as output:
                    count=0
                    while chunk:=response.read(256*1024):
                        count+=len(chunk)
                        if count>250_000_000:raise ValueError('This PDF exceeds the lightweight reader limit.')
                        output.write(chunk)
                os.replace(tmp,pdf)
            finally:tmp.unlink(missing_ok=True)
        info=pdf.with_suffix('.json')
        if not info.exists():
            result=subprocess.run(['pdfinfo',str(pdf)],capture_output=True,text=True,timeout=15)
            match=re.search(r'^Pages:\s+(\d+)',result.stdout,re.M)
            if match:info.write_text(json.dumps({'pages':int(match[1])}))
        if info.exists() and page>json.loads(info.read_text())['pages']:raise ValueError('That is beyond the last page. Use Previous to return.')
        image=STATE/'cache'/f'scan-{key}-{page}.png'
        if not image.exists():
            result=subprocess.run(['pdftoppm','-f',str(page),'-l',str(page),'-singlefile','-scale-to-x','2400','-scale-to-y','-1','-png',str(pdf),str(image.with_suffix(''))],capture_output=True,timeout=60)
            if result.returncode or not image.exists():raise ValueError('This PDF page could not be rendered.')
    return processed(image,options)


def processed(source,options):
    settings={key:options.get(key,default) for key,default in [('style','photo'),('contrast','normal'),('invert',0),('crop','full')]}
    settings['width']=int(1200*int(options.get('zoom',100))/100)
    digest=hashlib.sha256((str(source)+json.dumps(settings,sort_keys=True)+':eink-v1').encode()).hexdigest()
    path=STATE/'cache'/('eink-'+digest+'.png')
    if not path.exists():
        data=eink.convert(source,**settings)
        tmp=path.with_suffix('.'+secrets.token_hex(4)+'.tmp');tmp.write_bytes(data);os.replace(tmp,path)
    return path.read_bytes()


def archive_reader(identifier,page,get):
    data,file=pdf_file(identifier,get('file'))
    opts=display_options(get,'crisp');key,pdf=pdf_paths(identifier,file)
    total=None
    if pdf.with_suffix('.json').exists():total=json.loads(pdf.with_suffix('.json').read_text()).get('pages')
    if total:page=min(page,total)
    path='/archive/pages/'+identifier;state=dict(opts,page=page,file=file['name'])
    def url(**changes):return path+'?'+U.urlencode(dict(state,**changes))
    nav=f'<div class="readerbar"><a href="/archive/item/{esc(identifier)}">Back to item</a>'
    if page>1:nav+=f'<a href="{esc(url(page=page-1))}">← Previous page</a>'
    if not total or page<total:nav+=f'<a href="{esc(url(page=page+1))}">Next page →</a>'
    nav+='</div>'
    title=str(data.get('metadata',{}).get('title',identifier))
    body=nav+f'<p class="reader-title">{esc(title)} · Page {page}'+(f' of {total}' if total else '')+'</p>'
    if any(f['name']==file['name'] for f in delivery.supported_files(data)):
        body+=archive_send_buttons(identifier,file['name'])+'<p>Read opens the native Kindle reader and closes Linux.</p>'
    body+=display_controls(path,state,get('options')=='1')
    body+=f'<form class="jump" action="{path}">'
    for key,value in state.items():
        if key!='page':body+=f'<input type="hidden" name="{key}" value="{esc(value)}">'
    body+=f'<label>Page<input name="page" type="number" min="1" value="{page}"></label><button>Go</button></form>'
    image_url='/archive/scan/'+identifier+'?'+U.urlencode(state)
    image_style=f'width:{opts["zoom"]}%;' if opts['fit']=='width' else 'width:auto;max-width:100%;max-height:900px;'
    body+=f'<a href="{esc(url(zoom=150 if opts["zoom"]==100 else 200 if opts["zoom"]==150 else 100,fit="width"))}"><img class="view-image" alt="Magazine / PDF page" style="{image_style}" src="{esc(image_url)}"></a>'
    body+='<p class="reader-status">Tap the page to zoom. Swipe to pan. First opening downloads the PDF on the host.</p>'+nav
    (STATE/'cache'/('reading-'+identifier+'.json')).write_text(json.dumps(state))
    return reader_layout(title,body)


def archive_transfer(job_id,open_after):
    def update(state,message,destination=None):
        with db() as con:
            if destination is None:con.execute('UPDATE archive_jobs SET state=?,message=? WHERE id=?',(state,message,job_id))
            else:con.execute('UPDATE archive_jobs SET state=?,message=?,destination=? WHERE id=?',(state,message,destination,job_id))
    try:
        with db() as con:job=con.execute('SELECT * FROM archive_jobs WHERE id=?',(job_id,)).fetchone()
        data=metadata(job['item']);files=delivery.supported_files(data)
        file=next((f for f in files if f['name']==job['file']),None)
        if not file:raise ValueError('This public document is no longer available.')
        update('working','Downloading from Archive…')
        source=delivery.download(job['item'],file,STATE/'archive-downloads')
        update('working','Preparing and copying to your Kindle…')
        author=data.get('metadata',{}).get('creator','')
        if isinstance(author,list):author=', '.join(str(x) for x in author[:3])
        destination=delivery.prepare_and_deliver(source,job['title'],str(author))
        update('working' if open_after else 'sent','Saved in your Kindle library.',destination)
        if open_after:
            update('working','Indexing for the native reader. Linux will close when ready.')
            delivery.open_reader(destination)
            update('sent','Opening in the Kindle reader.',destination)
    except Exception as exc:update('error',str(exc))


def archive_job(job_id):
    with db() as con:job=con.execute('SELECT * FROM archive_jobs WHERE id=?',(job_id,)).fetchone()
    if not job:raise ValueError('Transfer not found.')
    pending=job['state'] in {'queued','working'}
    body=f'<article class="card"><h2>{esc(job["title"])}</h2><p>{esc(job["message"])}</p></article>'
    if job['destination']:body+='<p>Saved as '+esc(Path(job['destination']).name)+'</p>'
    body+=f'<p><a class="button" href="/archive/item/{esc(job["item"])}">Back to item</a></p>'
    if job['destination'] and not pending:
        body+=f'<form action="/archive/open" method="post">{csrf()}<input type="hidden" name="job" value="{esc(job_id)}"><button>Read on Kindle</button></form>'
    return layout('Send to Kindle',body,pending)


def lichess_page(message=''):
    name=LICHESS_LOGIN.saved().get('username','')
    body='<p>Native touch chess on your Kindle, connected directly to Lichess.</p>'
