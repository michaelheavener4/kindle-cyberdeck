            if key not in {'sort','adv','browse'} and options[key]: form+=f'<input type="hidden" name="{key}" value="{esc(options[key])}">'
    form+='<button>Search Archive</button></form>'
    form+=f'<div class="toolbar"><a href="{esc(archive_url(**dict(state,adv="0" if advanced else "1")))}">{"Simple" if advanced else "Advanced"} search</a><a href="/archive">Clear filters</a></div>'
    active=[f'{k.replace("_"," ")}: {v}' for k,v in options.items() if v and k not in {'sort','adv','browse','scope'}]
    if active: form+='<p class="muted">'+esc(' · '.join(active))+'</p>'
    if not query and kind=='all' and not active and options['browse']!='1':
        body=form+'<h2>Browse the collections</h2><div class="quick-links">'
        for ident,label in [('gutenberg','Project Gutenberg'),('americana','American Libraries'),('librivoxaudio','LibriVox audiobooks'),('prelinger','Prelinger films'),('softwarelibrary','Software Library')]:
            body+=f'<a href="{esc(archive_url(collection=ident,sort="downloads",browse="1"))}">{label}</a>'
        for value,label in ARCHIVE_TYPES[1:]: body+=f'<a href="{esc(archive_url(kind=value,sort="downloads",browse="1"))}">{label}</a>'
        return layout('Archive.org',body+'</div><p><a href="https://web.archive.org/">Wayback Machine — archived websites</a></p>')
    params={'q':archive_query(query,kind,options),'output':'json','rows':10,'page':page,
